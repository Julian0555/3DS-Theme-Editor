<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ThemeEditor.WPF.Controls.Renderers"
             xmlns:sett="clr-namespace:ThemeEditor.WPF.Properties"
             xmlns:controls="clr-namespace:ThemeEditor.WPF.Controls"
             xmlns:templating="clr-namespace:ThemeEditor.WPF.Templating"
             xmlns:markup="clr-namespace:ThemeEditor.WPF.Markup"
             xmlns:Effects="clr-namespace:ThemeEditor.WPF.Effects" xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Class="ThemeEditor.WPF.Controls.BottomOverlaysPreview"
             mc:Ignorable="d" ClipToBounds="True"
             d:DesignHeight="240" d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PreviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CloseOff" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{markup:Setting Path=Preview_CloseToggle}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CloseOn" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{markup:Setting Path=Preview_CloseToggle}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ButtonPressed" TargetType="Image">
                <Setter Property="Source" Value="/Controls/Resources/BottomButton/LncBtmBtn_11.png"/>
                <Style.Triggers>
                    <DataTrigger Binding="{markup:Setting Path=Preview_PressedToggle}" Value="True">
                        <Setter Property="Margin" Value="0,1,0,0"/>
                        <Setter Property="Source" Value="/Controls/Resources/BottomButton/LncBtmBtn_12.png"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OpenCloseText" TargetType="{x:Type Image}">
                <Setter Property="Effect">
                    <Setter.Value>
                        <Effects:ColorEffect Color="{Binding Colors.Open.TextUnpressed, FallbackValue=#4B4844, UpdateSourceTrigger=PropertyChanged}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Flags.OpenCloseColor}" Value="False">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <Effects:ColorEffect Color="{Binding ., FallbackValue=#4B4844}"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{markup:Setting Path=Preview_PressedToggle}" Value="True">
                        <Setter Property="Margin" Value="0,1,0,0"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <Effects:ColorEffect Color="{Binding Colors.Open.TextPressed, FallbackValue=#FFFFF9, UpdateSourceTrigger=PropertyChanged}"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{markup:Setting Path=Preview_PressedToggle}" Value="True"/>
                            <Condition Binding="{Binding Flags.OpenCloseColor}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <Effects:ColorEffect Color="{Binding ., FallbackValue=#FFFFF9}"/>
                            </Setter.Value>
                        </Setter>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OpenCloseTextGlow" TargetType="{x:Type Image}">
                <Setter Property="Effect">
                    <Setter.Value>
                        <Effects:ColorEffect Color="{Binding Colors.Open.TextShadow, FallbackValue=#FFFFF9, UpdateSourceTrigger=PropertyChanged}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Flags.OpenCloseColor}" Value="False">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <Effects:ColorEffect Color="{Binding ., FallbackValue=#FFFFF9}"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
