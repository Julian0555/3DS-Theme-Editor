<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ThemeEditor.WPF.Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:renderers="clr-namespace:ThemeEditor.WPF.Controls.Renderers"
             xmlns:templating="clr-namespace:ThemeEditor.WPF.Templating"
             xmlns:properties="clr-namespace:ThemeEditor.WPF.Properties"
             xmlns:Effects="clr-namespace:ThemeEditor.WPF.Effects" x:Class="ThemeEditor.WPF.Controls.BottomScreenPreview"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PreviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <templating:BooleanConverter TrueValue="{x:Static Visibility.Hidden}"
                                         FalseValue="{x:Static Visibility.Visible}"
                                         x:Key="CursorVisibilityConverter" />
            <!-- Rows 16 Base-->
            <system:Double x:Key="Row1">70</system:Double>
            <system:Double x:Key="Row2">123</system:Double>
            <system:Double x:Key="Row3">176</system:Double>
            <!-- Columns 1 Base-->
            <system:Double x:Key="Column1">54</system:Double>
            <system:Double x:Key="Column2">107</system:Double>
            <system:Double x:Key="Column3">160</system:Double>
            <system:Double x:Key="Column4">213</system:Double>
            <system:Double x:Key="Column5">266</system:Double>

            <templating:SwitchConverter x:Key="RowSelector">
                <templating:SwitchConverterCase Value="{StaticResource Row1}">
                    <templating:SwitchConverterCase.Case>
                        <system:Int32>2</system:Int32>
                    </templating:SwitchConverterCase.Case>
                </templating:SwitchConverterCase>
                <templating:SwitchConverterCase  Value="{StaticResource Row2}">
                    <templating:SwitchConverterCase.Case>
                        <system:Int32>1</system:Int32>
                    </templating:SwitchConverterCase.Case>
                </templating:SwitchConverterCase>
                <templating:SwitchConverterCase  Value="{StaticResource Row3}">
                    <templating:SwitchConverterCase.Case>
                        <system:Int32>0</system:Int32>
                    </templating:SwitchConverterCase.Case>
                </templating:SwitchConverterCase>
            </templating:SwitchConverter>

            <templating:SwitchConverter x:Key="ColumnSelector">
                <templating:SwitchConverterCase Value="{StaticResource Column1}">
                    <templating:SwitchConverterCase.Case>
                        <system:Int32>0</system:Int32>
                    </templating:SwitchConverterCase.Case>
                </templating:SwitchConverterCase>
                <templating:SwitchConverterCase Value="{StaticResource Column2}">
                    <templating:SwitchConverterCase.Case>
                        <system:Int32>1</system:Int32>
                    </templating:SwitchConverterCase.Case>
                </templating:SwitchConverterCase>
                <templating:SwitchConverterCase Value="{StaticResource Column3}">
                    <templating:SwitchConverterCase.Case>
                        <system:Int32>2</system:Int32>
                    </templating:SwitchConverterCase.Case>
                </templating:SwitchConverterCase>
                <templating:SwitchConverterCase Value="{StaticResource Column4}">
                    <templating:SwitchConverterCase.Case>
                        <system:Int32>3</system:Int32>
                    </templating:SwitchConverterCase.Case>
                </templating:SwitchConverterCase>
                <templating:SwitchConverterCase Value="{StaticResource Column5}">
                    <templating:SwitchConverterCase.Case>
                        <system:Int32>4</system:Int32>
                    </templating:SwitchConverterCase.Case>
                </templating:SwitchConverterCase>
            </templating:SwitchConverter>
            <templating:BooleanConverter x:Key="BooleanNegateConverter">
                <templating:BooleanConverter.TrueValue>
                    <system:Boolean>False</system:Boolean>
                </templating:BooleanConverter.TrueValue>
                <templating:BooleanConverter.FalseValue>
                    <system:Boolean>True</system:Boolean>
                </templating:BooleanConverter.FalseValue>
            </templating:BooleanConverter>
            <templating:BooleanMultiConverter TrueValue="{x:Static Visibility.Visible}"
                                              FalseValue="{x:Static Visibility.Hidden}"
                                              Operation="And" x:Key="BooleanOrConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Canvas ClipToBounds="True"
            DataContext="{Binding Theme, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
            Width="320px" Height="240px">
        <!-- Background -->
        <!-- Background -->
        <!-- Background -->
        <!-- Background -->
        <Image x:Name="RefOverlay" Source="/Controls/Resources/BottomScreenRef.png" Height="240" Width="320" RenderOptions.BitmapScalingMode="NearestNeighbor" IsEnabled="False" HorizontalAlignment="Center" VerticalAlignment="Center" d:IsHidden="True"/>
        <!-- Background -->
        <renderers:BottomWallpaperRenderer Theme="{Binding .}" IsEnabled="True" />
        <!-- No Cart -->
        <Canvas
            Visibility="{Binding Preview_Main_CartEnable, Converter={StaticResource BooleanToVisibilityConverter}, Source={x:Static properties:Settings.Default}}"
            Canvas.Left="{Binding Preview_Main_CartX, Converter={StaticResource ColumnSelector}, Source={x:Static properties:Settings.Default}}"
            Canvas.Top="{Binding Preview_Main_CartY, Converter={StaticResource RowSelector}, Source={x:Static properties:Settings.Default}}">
            <Canvas Style="{StaticResource PreviewItemShadowCaster}">
                <Path Style="{StaticResource NoCartStyleBack}" Data="{StaticResource FileGeometry}" />
                <Path Style="{StaticResource NoCartStyleFore}" Data="{StaticResource NoCartGeometryFore}" />
            </Canvas>
        </Canvas>
        <!-- File -->
        <Canvas
            Visibility="{Binding Preview_Main_FileEnable, Converter={StaticResource BooleanToVisibilityConverter}, Source={x:Static properties:Settings.Default}}"
            Canvas.Left="{Binding Preview_Main_FileX, Converter={StaticResource ColumnSelector}, Source={x:Static properties:Settings.Default}}"
            Canvas.Top="{Binding Preview_Main_FileY, Converter={StaticResource RowSelector}, Source={x:Static properties:Settings.Default}}">
            <Canvas Style="{StaticResource PreviewFileShadowCaster}">
                <Path Style="{StaticResource FileStyleBack}" Data="{StaticResource FileGeometry}" />
            </Canvas>
            <Path Style="{StaticResource FileStyleFore}" Data="{StaticResource FileGeometry}" />
            <Path Data="{StaticResource FileLabelGeometry}">
                <Path.Fill>
                    <ImageBrush ImageSource="{Binding Info.LargeIcon.Bitmap}" Stretch="Fill" />
                </Path.Fill>
            </Path>
        </Canvas>
        <!-- Folder -->
        <Canvas
            Visibility="{Binding Preview_Main_FolderEnable, Converter={StaticResource BooleanToVisibilityConverter}, Source={x:Static properties:Settings.Default}}"
            Canvas.Left="{Binding Preview_Main_FolderX, Converter={StaticResource ColumnSelector}, Source={x:Static properties:Settings.Default}}"
            Canvas.Top="{Binding Preview_Main_FolderY, Converter={StaticResource RowSelector}, Source={x:Static properties:Settings.Default}}">
            <Canvas Style="{StaticResource PreviewFolderShadowCaster}">
                <Path Style="{StaticResource FolderStyleBackClosed}" Data="{StaticResource FolderGeometryBackClosed}" />
            </Canvas>

            <Canvas>
                <Canvas.Clip>
                    <RectangleGeometry Rect="-20,-23,40,9" />
                </Canvas.Clip>
                <Path Style="{StaticResource FolderItemStyleBack}" Data="{StaticResource FolderItemGeometry}" />
                <Path Style="{StaticResource FolderItemStyleFore}" Data="{StaticResource FolderItemGeometry}" />
            </Canvas>
            <Path Style="{StaticResource FolderStyleForeClosed}" Data="{StaticResource FolderGeometryForeClosed}" />
        </Canvas>
        <!-- Cursor -->
        <Canvas
            Canvas.Left="{Binding Preview_Main_CursorX, Converter={StaticResource ColumnSelector}, Source={x:Static properties:Settings.Default}}"
            Canvas.Top="{Binding Preview_Main_CursorY, Converter={StaticResource RowSelector}, Source={x:Static properties:Settings.Default}}">
            <Canvas.Visibility>
                <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                    <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}" Path="HideCursor"
                             Converter="{StaticResource BooleanNegateConverter}" />
                    <Binding Source="{x:Static properties:Settings.Default}" Path="Preview_Main_CursorEnable" />
                </MultiBinding>
            </Canvas.Visibility>
            <Path Style="{StaticResource CursorStyleSolid}" Data="{StaticResource CursorGeometry}" />
            <Path Style="{StaticResource CursorStyleGlow}" Data="{StaticResource CursorGeometry}" />
        </Canvas>
        <Canvas x:Name="Folder" Height="240" Width="320">
            <Image Canvas.Left="26" Source="/Controls/Resources/LncFolder_13.png" Canvas.Top="156" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.Effect>
                    <Effects:FolderEffect
                    ColorA="{Binding Colors.Folder.Dark, FallbackValue=#0000FF, UpdateSourceTrigger=PropertyChanged}"
                    ColorB="{Binding Colors.Folder.Main, FallbackValue=#00FF00, UpdateSourceTrigger=PropertyChanged}"
                    ColorC="{Binding Colors.Folder.Light, FallbackValue=#FF0000, UpdateSourceTrigger=PropertyChanged}"
                    MidpointAB="0.4"
                    MidpointBC="0.39"
                    />
                </Image.Effect>
            </Image>
            <Image Source="/Controls/Resources/LncFile_13.png" Canvas.Left="26" Canvas.Top="150" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.Effect>
                    <Effects:FolderEffect
                        ColorA="{Binding Colors.File.Dark, FallbackValue=#FF0000, UpdateSourceTrigger=PropertyChanged}"
                        ColorB="{Binding Colors.File.Main, FallbackValue=#00FF00, UpdateSourceTrigger=PropertyChanged}"
                        ColorC="{Binding Colors.File.Light, FallbackValue=#0000FF, UpdateSourceTrigger=PropertyChanged}"
                        MidpointAB="0.2"
                        MidpointBC="0.4"
                    />
                </Image.Effect>
            </Image>
        </Canvas>
    </Canvas>
</UserControl>